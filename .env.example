# Rewire configuration.
# Copy to .env and fill in. Never commit .env -- it is git-ignored.
# All variables are namespaced REWIRE_; nested sections use a double underscore.

# ---------------------------------------------------------------- general ---
REWIRE_ENVIRONMENT=local          # local | ci | production
REWIRE_DEBUG=false
REWIRE_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
REWIRE_LOG_FORMAT=console         # console | json
REWIRE_DATA_DIR=.rewire

# --------------------------------------------------------------- database ---
# SQLite by default so the MVP needs no infrastructure. Models are written to be
# Postgres-compatible; switch by changing this URL alone.
REWIRE_DATABASE_URL=sqlite+aiosqlite:///.rewire/rewire.db
# REWIRE_DATABASE_URL=postgresql+asyncpg://rewire:rewire@localhost:5432/rewire

# -------------------------------------------------------------------- LLM ---
# Provider stays 'null' until Phase 4; deterministic analysis needs no LLM.
REWIRE_LLM__PROVIDER=null                 # null | anthropic | openai | openrouter
REWIRE_LLM__MODEL=claude-sonnet-5
REWIRE_LLM__TEMPERATURE=0.0
REWIRE_LLM__MAX_OUTPUT_TOKENS=8192
REWIRE_LLM__TIMEOUT_SECONDS=120
REWIRE_LLM__MAX_RETRIES=3
# REWIRE_LLM__ANTHROPIC_API_KEY=
# REWIRE_LLM__OPENAI_API_KEY=
# REWIRE_LLM__OPENROUTER_API_KEY=

# ---------------------------------------------------------------- sandbox ---
# Hard limits for executing untrusted repository code. Network is off by default.
REWIRE_SANDBOX__IMAGE=python:3.12-slim
REWIRE_SANDBOX__TIMEOUT_SECONDS=600
REWIRE_SANDBOX__MEMORY_LIMIT_MB=2048
REWIRE_SANDBOX__CPU_LIMIT=2.0
REWIRE_SANDBOX__PIDS_LIMIT=512
REWIRE_SANDBOX__NETWORK=none               # none | bridge
REWIRE_SANDBOX__READ_ONLY_ROOTFS=true
REWIRE_SANDBOX__MAX_REPO_SIZE_MB=512
REWIRE_SANDBOX__MAX_FILE_SIZE_KB=1024

# ------------------------------------------------------------------ agent ---
REWIRE_AGENT__MAX_ITERATIONS=3
REWIRE_AGENT__MAX_TOOL_CALLS=40
REWIRE_AGENT__MAX_TOKENS_PER_TASK=250000
REWIRE_AGENT__MAX_FILES_PER_PATCH=25

# ------------------------------------------------------------------ watch ---
# Policy for following an upstream specification unattended. The fetcher sends
# no credential of any kind, so there is nothing here to authenticate with.
REWIRE_WATCH__TIMEOUT_SECONDS=30
REWIRE_WATCH__MAX_SPEC_MB=32
REWIRE_WATCH__ALLOW_HTTP=false             # plain HTTP, before and after redirects

# ----------------------------------------------------------------- github ---
# REWIRE_GITHUB_TOKEN=
